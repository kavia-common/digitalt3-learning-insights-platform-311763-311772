# LMS Backend environment variables (example only)
# NOTE: Do not commit real secrets. Populate these in your actual .env or deployment environment.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS (optional)
# Comma-separated list; use '*' to allow all origins (development only)
ALLOWED_ORIGINS=*
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=600
TRUST_PROXY=true

# MySQL (AWS RDS / managed MySQL)
# Required:
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DEFAULT_DB=

# MongoDB (legacy / migration)
# NOTE: MongoDB models still exist in src/models/**, but backend startup now uses MySQL.
# These will be removed/fully migrated in later subtasks.
# MONGODB_URL=
# MONGODB_DB=DigitalT3_LMS

# JWT Auth
# Secret used to sign JWTs (DO NOT USE REAL SECRET HERE)
JWT_SECRET=

# Token validity (jsonwebtoken format, e.g. "7d", "12h", "3600s")
# Preferred variable name:
JWT_EXPIRES_IN=7d

# Backward compatibility (optional): older configs may use JWT_EXPIRESIN (no underscore)
# JWT_EXPIRESIN=7d
