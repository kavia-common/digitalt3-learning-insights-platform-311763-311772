# LMS Backend environment variables (example only)
# NOTE: Do not commit real secrets. Populate these in your actual .env or deployment environment.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS (optional)
# Comma-separated list; use '*' to allow all origins (development only)
ALLOWED_ORIGINS=*
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=600
TRUST_PROXY=true

# MongoDB (Atlas / local)
# Full MongoDB connection string (Atlas SRV recommended)
# Example (DO NOT USE REAL CREDENTIALS HERE):
# MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_URL=

# Optional database name; used as mongoose dbName when the URI doesn't include a /dbname path
# (Default-safe: if omitted, MongoDB's default DB selection rules apply.)
MONGODB_DB=Cluster0

# JWT Auth
# Secret used to sign JWTs (DO NOT USE REAL SECRET HERE)
JWT_SECRET=

# Token validity (jsonwebtoken format, e.g. "7d", "12h", "3600s")
# Preferred variable name:
JWT_EXPIRES_IN=7d

# Backward compatibility (optional): older configs may use JWT_EXPIRESIN (no underscore)
# JWT_EXPIRESIN=7d
