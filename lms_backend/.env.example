# --- Core DB/Auth (existing) ---
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DEFAULT_DB=
JWT_SECRET=

# --- AWS / RDS (recommended for production) ---
AWS_REGION=us-east-2

# --- MySQL SSL (AWS RDS) ---
# By default SSL is enabled in code; set DB_SSL=false to disable.
DB_SSL=true
# Optional: override CA bundle path. If unset, backend will look for ./global-bundle.pem at runtime.
DB_SSL_CA_PATH=

# --- AI / Anthropic Claude ---
# Required to enable POST /lessons/:lessonId/generate-ai (and /api/lessons/:lessonId/generate-ai)
ANTHROPIC_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=1024
